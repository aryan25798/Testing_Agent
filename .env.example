# Application Environment Configuration Example
# Copy this file to .env and configure with appropriate values.

# General App Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME=TestingAgentPlatform

# Server Settings
APP_HOST=127.0.0.1
APP_PORT=8000
STREAMLIT_PORT=8501

# Security
SECRET_KEY=replace_with_a_secure_random_string_in_env

# Database Configuration
DATABASE_URL=sqlite:///./testing_platform.db

# External Services / LLM / Agent Keys (if applicable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
