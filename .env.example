# =====================================================================
# AI Testing Assistant - Environment Configuration Template
# =====================================================================
# Copy this file to .env in testing-agent-platform/ directory:
#   cp .env.example .env
# =====================================================================

# --- General Application Settings ---
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME=AI-Testing-Assistant

# --- FastAPI Backend Server Settings ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Frontend Angular Client Settings ---
FRONTEND_URL=http://localhost:4200

# --- Security ---
SECRET_KEY=replace_with_a_secure_random_string_in_production

# --- SQLite Database Storage ---
DATABASE_URL=sqlite:///./testing_platform.db

# --- AI Provider API Keys ---
# You can place your API keys here OR configure them directly in the UI 
# at http://localhost:4200/models (AI Model Settings page)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional Integrations ---
# Jira Cloud
JIRA_HOST_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# GitHub
GITHUB_TOKEN=
